rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isVideoUpload() {
      return request.resource != null
        && request.resource.size < 2 * 1024 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    function isPlatformAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.admin == 'true'
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    match /avatarIntroVideos/{avatarSlug}/{fileName} {
      allow read: if true;
      allow create, update: if isPlatformAdmin() && isVideoUpload();
      allow delete: if isPlatformAdmin();
    }

    match /nwgNewsVideos/videos/{year}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() && isVideoUpload();
      allow delete: if signedIn();
    }

    match /{topLevel}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && topLevel != 'nwgNewsVideos'
        && topLevel != 'avatarIntroVideos';
    }
  }
}
