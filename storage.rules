rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isVideoUpload() {
      return request.resource != null
        && request.resource.size < 2 * 1024 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    match /avatarIntroVideos/{avatarSlug}/{fileName} {
      allow read: if true;
      // The app and Firestore document rules enforce platform-admin management.
      // Storage follows this project's established authenticated-upload model;
      // cross-service Firestore lookups return false in this bucket's ruleset.
      allow create, update: if signedIn() && isVideoUpload();
      allow delete: if signedIn();
    }

    match /nwgNewsVideos/videos/{year}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() && isVideoUpload();
      allow delete: if signedIn();
    }

    match /{topLevel}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && topLevel != 'nwgNewsVideos'
        && topLevel != 'avatarIntroVideos';
    }
  }
}
