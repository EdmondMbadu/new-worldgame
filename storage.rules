rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isVideoUpload() {
      return request.resource != null
        && request.resource.size < 2 * 1024 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    function isSolutionImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /solutions/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isSolutionImageUpload();
      allow delete: if signedIn();
    }

    match /avatarIntroVideos/{avatarSlug}/{fileName} {
      allow read: if true;
      // The app and Firestore document rules enforce platform-admin management.
      // Storage follows this project's established authenticated-upload model;
      // cross-service Firestore lookups return false in this bucket's ruleset.
      allow create, update: if signedIn() && isVideoUpload();
      allow delete: if signedIn();
    }

    match /nwgNewsVideos/videos/{year}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn() && isVideoUpload();
      allow delete: if signedIn();
    }

    // Raw drafts and published campaign artifacts are server-managed. The
    // public renderer streams approved HTML with strict response headers.
    match /campaign-drafts/{allPaths=**} {
      allow read, write: if false;
    }

    match /campaign-published/{allPaths=**} {
      allow read, write: if false;
    }

    match /campaign-assets/{allPaths=**} {
      allow read, write: if false;
    }

    match /{topLevel}/{allPaths=**} {
      allow read: if topLevel != 'campaign-drafts'
        && topLevel != 'campaign-published'
        && topLevel != 'campaign-assets';
      allow write: if signedIn()
        && topLevel != 'solutions'
        && topLevel != 'nwgNewsVideos'
        && topLevel != 'avatarIntroVideos'
        && topLevel != 'campaign-drafts'
        && topLevel != 'campaign-published'
        && topLevel != 'campaign-assets';
    }
  }
}
