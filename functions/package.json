{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test:moderation": "npm run build && node --test test/solution-moderation-core.test.js",
    "test:campaign": "npm run build && node --test test/campaign-pages.test.js",
    "test:reporting-user-filter": "npm run build && node --test test/reporting-user-filter.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "community-feed:audit": "node scripts/backfill-community-solutions.js",
    "community-feed:apply": "node scripts/backfill-community-solutions.js --apply",
    "community-projection-status:audit": "node scripts/backfill-publication-status-projections.js",
    "community-projection-status:apply": "node scripts/backfill-publication-status-projections.js --apply",
    "moderation:prepare-legacy": "node scripts/prepare-solution-moderation.js",
    "moderation:prepare-legacy:apply": "node scripts/prepare-solution-moderation.js --apply",
    "test:weekly-brief": "npm run build && node --test test/weekly-brief*.test.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/speech": "~7.5.0",
    "@google-cloud/text-to-speech": "~6.4.1",
    "@google/genai": "^2.13.0",
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/mail": "^8.1.0",
    "axios": "~1.18.1",
    "busboy": "~1.6.0",
    "cors": "^2.8.5",
    "firebase-admin": "~13.10.0",
    "firebase-functions": "~6.6.0",
    "googleapis": "~173.0.0",
    "mammoth": "^1.11.0",
    "mime-types": "^3.0.1",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^4.0.1",
    "sanitize-html": "2.17.5",
    "stripe": "^17.7.0",
    "twilio": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.19",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "private": true
}
