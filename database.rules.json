{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['state', 'lastChanged'])",
        "state": {
          ".validate": "newData.val() == 'online' || newData.val() == 'offline'"
        },
        "lastChanged": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "typing": {
      "$contextId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['displayName', 'updatedAt'])",
          "displayName": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "avatarUrl": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "activity": {
            ".validate": "newData.isString() && (newData.val() == 'discussion' || newData.val() == 'solution')"
          },
          "locationLabel": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
