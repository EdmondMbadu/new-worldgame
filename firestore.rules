rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPlatformAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == 'true'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    match /avatar_intro_videos/{avatarSlug} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    match /nwgNewsSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    match /gsl-workshop-announcement-signups/{signupId} {
      allow read, delete: if isPlatformAdmin();
      allow create, update: if request.time < timestamp.date(2028, 11, 3)
        && request.resource.data.keys().hasOnly([
          'email',
          'workshopYear',
          'source',
          'subscribedAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@]+@[^@]+[.][^@]+$')
        && request.resource.data.workshopYear == 2027
        && request.resource.data.source == 'global-labs-page'
        && request.resource.data.subscribedAt == request.time;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function canReadSolution(solution) {
      let moderation = solution.get('moderation', {});
      let hasApprovedModeration =
        solution.get('moderationLegacyExempt', false) == true
        || (
          moderation.get('status', '') == 'approved'
          && moderation.get('contentHash', '') != ''
          && moderation.get('contentHash', '') == moderation.get('approvedContentHash', '')
        );
      return (
          solution.get('statusForPublication', '') == 'approved'
          && hasApprovedModeration
        )
        || (
          isSignedIn()
          && (
            solution.get('isPrivate', false) != true
            || solution.get('teamMemberEmails', []).hasAny([authEmail()])
            || isPlatformAdmin()
          )
        );
    }

    function changesProtectedVisibilityFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isPrivate',
        'communityVisibility',
        'feedEligible',
        'feedStatus',
        'teamMemberEmails',
        'solutionAdminEmails',
        'visibilityUpdatedAt',
        'visibilityUpdatedBy',
        'moderationLegacyExempt',
        'moderation',
        'statusForPublication',
        'publicationReviewedAtMs',
        'publicationReviewedByUid',
        'publicationReviewedByEmail'
      ]);
    }

    function solutionOwnerUid(solution) {
      return solution.get(
        'ownerAccountId',
        solution.get('authorAccountId', solution.get('initiatorId', ''))
      );
    }

    function solutionOwnerEmail(solution) {
      return solution.get('ownerEmail', solution.get('authorEmail', ''));
    }

    function isCurrentSolutionOwner(solution) {
      return isSignedIn()
        && (
          solutionOwnerUid(solution) == request.auth.uid
          || solutionOwnerEmail(solution) == authEmail()
        );
    }

    function changesSolutionOwnership() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ownerAccountId',
        'ownerEmail',
        'ownerName',
        'ownerProfileCredential',
        'ownerProfilePicture',
        'ownershipTransferredAtMs',
        'ownershipTransferredByUid',
        'ownershipTransferredByEmail',
        'ownershipHistory'
      ]);
    }

    function validSolutionOwnershipTransfer() {
      let nextOwnerUid = request.resource.data.get('ownerAccountId', '');
      let nextOwnerEmail = request.resource.data.get('ownerEmail', '');
      return (
          isPlatformAdmin()
          || isCurrentSolutionOwner(resource.data)
        )
        && nextOwnerUid is string
        && nextOwnerUid.size() > 0
        && nextOwnerEmail is string
        && nextOwnerEmail.size() > 0
        && exists(/databases/$(database)/documents/users/$(nextOwnerUid))
        && get(
          /databases/$(database)/documents/users/$(nextOwnerUid)
        ).data.email.lower() == nextOwnerEmail.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerAccountId',
          'ownerEmail',
          'ownerName',
          'ownerProfileCredential',
          'ownerProfilePicture',
          'chosenAdmins',
          'solutionAdminEmails',
          'teamMemberEmails',
          'ownershipTransferredAtMs',
          'ownershipTransferredByUid',
          'ownershipTransferredByEmail',
          'ownershipHistory',
          'updatedAt'
        ]);
    }

    // Solution documents are community-readable only for authenticated
    // members. Approved publication remains the separate, public pathway.
    match /{path=**}/solutions/{solutionId} {
      allow read: if canReadSolution(resource.data);
      allow create: if isSignedIn()
        && !request.resource.data.keys().hasAny([
          'moderation',
          'moderationLegacyExempt',
          'publicationReviewedAtMs',
          'publicationReviewedByUid',
          'publicationReviewedByEmail'
        ])
        && request.resource.data.get('statusForPublication', '') != 'approved';
      allow update: if isSignedIn()
        && (
          (
            !changesSolutionOwnership()
            && (
              !changesProtectedVisibilityFields()
              || isPlatformAdmin()
              || resource.data.get('solutionAdminEmails', []).hasAny([authEmail()])
            )
          )
          || (
            changesSolutionOwnership()
            && validSolutionOwnershipTransfer()
          )
        );
      allow delete: if isPlatformAdmin()
        || (
          isSignedIn()
          && (
            solutionOwnerUid(resource.data) == request.auth.uid
            || resource.data.get('solutionAdminEmails', []).hasAny([authEmail()])
          )
        );
    }

    match /solutions/{solutionId}/communityComments/{commentId} {
      allow read: if canReadSolution(
        get(/databases/$(database)/documents/solutions/$(solutionId)).data
      );
      // Comments are created by the authenticated callable function so the
      // server can enforce privacy, count atomically, and notify the team.
      allow create, update, delete: if false;
    }

    match /solutions/{solutionId}/strategyReviewRevisions/{revisionId} {
      allow read: if canReadSolution(
        get(/databases/$(database)/documents/solutions/$(solutionId)).data
      );
      allow create: if isSignedIn();
      allow update, delete: if isPlatformAdmin();
    }

    // Deliberately minimal, server-maintained card data for the public home
    // feed. Full solution documents remain protected by the rules above.
    match /publicCommunitySolutions/{solutionId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Small server-maintained moderation records. Administrators can inspect
    // the queue, but every decision and policy mutation goes through a callable
    // function so client code cannot grant public visibility.
    match /solutionModerationQueue/{solutionId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /solutionModerationPolicies/{policyId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    match /solutionModerationCache/{cacheId} {
      allow read, create, update, delete: if false;
    }

    // Challenge-space prompt templates are readable by signed-in solution
    // participants. All mutations go through admin-authorized callable
    // functions, which also validate the stable answer-key schema and write
    // an immutable revision record.
    match /challengeQuestionTemplates/{challengePageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;

      match /revisions/{revisionId} {
        allow read, create, update, delete: if false;
      }
    }

    // School invitation lookup uses a collection-group query. Firestore
    // requires an explicit collection-group match so the query can prove that
    // every possible result belongs to the signed-in invitee.
    match /{path=**}/students/{studentId} {
      allow read: if request.auth != null
        && request.auth.token.email is string
        && resource.data.email is string
        && resource.data.email == request.auth.token.email;
    }

    match /{topLevelCollection}/{document=**} {
      // This rule allows anyone with your database reference to view, edit,
      // and delete all data in your database. It is useful for getting
      // started, but it is configured to expire after 30 days because it
      // leaves your app open to attackers. At that time, all client
      // requests to your database will be denied.
      //
      // Make sure to write security rules for your app before that time, or
      // else all client requests to your database will be denied until you
      // update your rules.
      allow read: if request.time < timestamp.date(2028, 11, 3)
        && topLevelCollection != 'gsl-workshop-announcement-signups'
        && topLevelCollection != 'solutions'
        && topLevelCollection != 'challengeQuestionTemplates'
        && topLevelCollection != 'publicCommunitySolutions'
        && topLevelCollection != 'solutionModerationQueue'
        && topLevelCollection != 'solutionModerationPolicies'
        && topLevelCollection != 'solutionModerationCache';
      allow write: if request.time < timestamp.date(2028, 11, 3)
        && topLevelCollection != 'avatar_intro_videos'
        && topLevelCollection != 'nwgNewsSettings'
        && topLevelCollection != 'gsl-workshop-announcement-signups'
        && topLevelCollection != 'solutions'
        && topLevelCollection != 'challengeQuestionTemplates'
        && topLevelCollection != 'publicCommunitySolutions'
        && topLevelCollection != 'solutionModerationQueue'
        && topLevelCollection != 'solutionModerationPolicies'
        && topLevelCollection != 'solutionModerationCache';
    }
  }
}
