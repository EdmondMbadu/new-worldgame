rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPlatformAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == 'true'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    match /avatar_intro_videos/{avatarSlug} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    match /nwgNewsSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    match /gsl-workshop-announcement-signups/{signupId} {
      allow read, delete: if isPlatformAdmin();
      allow create, update: if request.time < timestamp.date(2028, 11, 3)
        && request.resource.data.keys().hasOnly([
          'email',
          'workshopYear',
          'source',
          'subscribedAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@]+@[^@]+[.][^@]+$')
        && request.resource.data.workshopYear == 2027
        && request.resource.data.source == 'global-labs-page'
        && request.resource.data.subscribedAt == request.time;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email
        : '';
    }

    function canReadSolution(solution) {
      return solution.get('statusForPublication', '') == 'approved'
        || (
          isSignedIn()
          && (
            solution.get('isPrivate', false) != true
            || solution.get('teamMemberEmails', []).hasAny([authEmail()])
            || isPlatformAdmin()
          )
        );
    }

    function changesProtectedVisibilityFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isPrivate',
        'communityVisibility',
        'feedEligible',
        'feedStatus',
        'teamMemberEmails',
        'solutionAdminEmails',
        'visibilityUpdatedAt',
        'visibilityUpdatedBy'
      ]);
    }

    // Solution documents are community-readable only for authenticated
    // members. Approved publication remains the separate, public pathway.
    match /{path=**}/solutions/{solutionId} {
      allow read: if canReadSolution(resource.data);
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && (
          !changesProtectedVisibilityFields()
          || isPlatformAdmin()
          || resource.data.get('solutionAdminEmails', []).hasAny([authEmail()])
        );
      allow delete: if isPlatformAdmin()
        || (
          isSignedIn()
          && (
            resource.data.authorAccountId == request.auth.uid
            || resource.data.get('solutionAdminEmails', []).hasAny([authEmail()])
          )
        );
    }

    match /solutions/{solutionId}/communityComments/{commentId} {
      allow read: if canReadSolution(
        get(/databases/$(database)/documents/solutions/$(solutionId)).data
      );
      // Comments are created by the authenticated callable function so the
      // server can enforce privacy, count atomically, and notify the team.
      allow create, update, delete: if false;
    }

    match /solutions/{solutionId}/strategyReviewRevisions/{revisionId} {
      allow read: if canReadSolution(
        get(/databases/$(database)/documents/solutions/$(solutionId)).data
      );
      allow create: if isSignedIn();
      allow update, delete: if isPlatformAdmin();
    }

    // Deliberately minimal, server-maintained card data for the public home
    // feed. Full solution documents remain protected by the rules above.
    match /publicCommunitySolutions/{solutionId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // School invitation lookup uses a collection-group query. Firestore
    // requires an explicit collection-group match so the query can prove that
    // every possible result belongs to the signed-in invitee.
    match /{path=**}/students/{studentId} {
      allow read: if request.auth != null
        && request.auth.token.email is string
        && resource.data.email is string
        && resource.data.email == request.auth.token.email;
    }

    match /{topLevelCollection}/{document=**} {
      // This rule allows anyone with your database reference to view, edit,
      // and delete all data in your database. It is useful for getting
      // started, but it is configured to expire after 30 days because it
      // leaves your app open to attackers. At that time, all client
      // requests to your database will be denied.
      //
      // Make sure to write security rules for your app before that time, or
      // else all client requests to your database will be denied until you
      // update your rules.
      allow read: if request.time < timestamp.date(2028, 11, 3)
        && topLevelCollection != 'gsl-workshop-announcement-signups'
        && topLevelCollection != 'solutions'
        && topLevelCollection != 'publicCommunitySolutions';
      allow write: if request.time < timestamp.date(2028, 11, 3)
        && topLevelCollection != 'avatar_intro_videos'
        && topLevelCollection != 'nwgNewsSettings'
        && topLevelCollection != 'gsl-workshop-announcement-signups'
        && topLevelCollection != 'solutions'
        && topLevelCollection != 'publicCommunitySolutions';
    }
  }
}
